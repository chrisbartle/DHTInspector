// Generated by CMake into the build directory: every version number here
// comes from the project() call in the top-level CMakeLists.txt, so there
// is only one place to change it. Do not edit the generated copy.

#include <windows.h>

// The icon the shell shows for the .exe. The lowest-numbered icon resource
// is the one Explorer uses, so keep this first.
1 ICON "@DHTINSPECTOR_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @DHTINSPECTOR_VERSION_COMMAS@
PRODUCTVERSION @DHTINSPECTOR_VERSION_COMMAS@
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // US English, Unicode: must agree with the Translation value below.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Chris Bartle"
            VALUE "FileDescription",  "@PROJECT_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "DHTInspector"
            VALUE "LegalCopyright",   "Copyright (C) Chris Bartle"
            VALUE "OriginalFilename", "DHTInspector.exe"
            VALUE "ProductName",      "DHT Inspector"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
